%% Persistent and temporary loops must never be connected across the write authorization boundary.
%% Both branches call the same pure in-memory registered-concept and definition checks.
%% Passing program checks does not prove complete semantics or learner mastery.
flowchart TD
    U0["v0.1.4 · 用户提出学习需求"] --> sessionConsent{"本会话已明确选择数据方式，且授权模式与范围仍有效？"}
    sessionConsent -->|"否：首次／新会话／模式变更／范围冲突"| askDataMode["先展示三项选择并等待；无默认值，不按已有文件猜测同意"]
    askDataMode --> dataChoice{"用户明确选择的数据方式"}
    askDataMode -. "未答或含糊" .-> waitChoice["只澄清选择；不查询用户库、不诊断、不教学"]
    waitChoice -. "取得明确选择后" .-> dataChoice
    sessionConsent -->|"是：本会话不重复问"| dataChoice

    subgraph entryData["教学启动门：三种数据授权独立于任务类型"]
        createSetup["create_boundary：确认独立保存位置与允许数据范围；旧文件不覆盖"]
        createConsent{"位置与数据范围已确认，且目标清楚？"}
        createPending["只问缺失授权或目标信息；暂不建档、不启动教学"]
        createBoundary["围绕本次目标做最小必要提问；区分会／不会／未知及来源；确认本次知识边界后结构化建档"]
        existingSetup["use_existing：确认用户指定的精确数据库或目录、允许读取范围；默认只读"]
        existingConsent{"精确来源与范围已明确授权？"}
        existingPending["等待精确位置与范围；不得扫描其他目录、猜测库或静默新建"]
        existingRead["只读允许材料；笔记与文件存在不证明掌握；必要未知用本轮小任务补测"]
        existingCompatible{"是兼容 Understanding Cost 库，且另获明确追加写入授权？"}
        existingTemporary["其他情况保持只读；通用数据库仅作来源材料；不新建、不复制、不自动转换、不改原库"]
        noDataSetup["no_personal_data：不读历史画像、其他聊天或任何个人库；不创建持久档案，不计算 Focus"]
        noDataTemporary["只使用当前学习请求、本轮回答及公开领域资料；临时确认必要前提"]
        authorizedWrite["允许持久化：仅已确认 create_boundary，或兼容现有库另获追加写入授权"]
    end

    dataChoice -->|"创建知识边界"| createSetup
    createSetup --> createConsent
    createConsent -->|"否"| createPending
    createPending -. "补齐后" .-> createConsent
    createConsent -->|"是；首次或尚未确认本次边界"| createBoundary
    createBoundary --> authorizedWrite
    dataChoice -->|"使用自己的数据库"| existingSetup
    existingSetup --> existingConsent
    existingConsent -->|"否"| existingPending
    existingPending -. "补齐后" .-> existingConsent
    existingConsent -->|"是"| existingRead
    existingRead --> existingCompatible
    existingCompatible -->|"是"| authorizedWrite
    existingCompatible -->|"否"| existingTemporary
    dataChoice -->|"不使用个人数据"| noDataSetup
    noDataSetup --> noDataTemporary

    subgraph temporaryLoop["只读或无个人数据：临时双核心闭环，禁止调用任何 Vault writer"]
        tempEntry["只保留本会话必要上下文；不执行 init／append-evidence／issue-route／issue-teaching／schedule-retention"]
        tempTask{"任务类型？数据方式不是任务类型"}
        tempMap["整体地图：只给完成当前判断所需的结构、关系与最少说明；资料覆盖与学习者掌握分开"]
        tempMapPick{"是否选择节点继续学习？"}
        tempMapEnd["结束地图；未生成学习档案"]
        tempContinue["继续学习只使用本会话断点或已授权只读材料；不存在时说明缺失，不访问其他历史"]
        tempGoal["确定本次可观察目标、范围与必要前提"]
        tempBoundary["最少问题确认必要前提；unknown 不作不会；自述、兴趣、笔记不作独立掌握"]
        tempCoreOne["核心一：临时知识边界与最短可行路径；不为缺数据补造画像、成本或 Focus 分数"]
        tempBasis["只有合格、同范围的知识证据才能承担推理；兴趣只作情境；无个人数据绝不计算 Focus；只读既有库仅在现有合格证据与当前同范围可比安全候选齐备时临时使用 Focus，不强算、不持久化"]
        tempConceptRegistry["核心一会话内交接：当前概念及本步相关概念的名称/别名、已验证锚点、待落地词；不创建后台档案"]
        tempModelType{"本步涉及新模型或算法概念？"}
        tempModelUnderstood{"已有同范围作答证明用户理解模型解决的问题、表示含义与例子关系？"}
        tempModelGrounding["本步草稿先解释：要解决的问题→模型表示什么→最小例子；提问检查语义，暂不出现公式"]
        tempFormulaNeeded{"当前目标确实需要公式？"}
        tempFormulaDraft["理解已确认后才准备公式小步；先解释符号所指与关系，不把程序检查当理解证据"]
        tempCoreTwo["核心二拟稿：据路径选择文字活动；陌生词说明是什么、属于谁或在哪里、作用与关系方向"]
        tempDependency{"解释依赖已懂内容或本单元已解释概念？"}
        tempGround["局部缺词先落地；真正前置缺口回核心一；不得用另一个未解释术语定义"]
        tempUnit["仅准备一个可验证文字单元草稿；复杂归属、空间或多状态关系才补最小标注静态图及文字等价说明"]
        tempMachineCheck[["调用同一纯内存检查：扫描实际用户正文中的已登记概念及别名，不只检查作者申报；校验定义四项和先后依赖"]]
        tempMachinePass{"已登记而未验证的概念均在使用前落地，四项无明显占位/自指/循环定义？"}
        tempAgentReview["Agent 再审未登记承重概念、实质含义与模型先语义后公式顺序；程序通过不代表语义或掌握通过"]
        tempSemanticPass{"Agent 语义复核通过？"}
        tempDraftReject["输出前拒绝草稿；缺定义或语义不实先改写，真正前置缺口回核心一"]
        tempOutput["全部检查通过后才展示本步；不签发 Vault、不写入档案，不把生成解释算作理解"]
        tempResponse["用户作答；给最小纠错反馈；只在会话内更新路径与当前理解判断"]
        tempReady{"是否能独立进入本单元检查？"}
        tempRepair["先做最小文字修复；不因一次失败直接换视频，不把过程帮助后的正确当掌握"]
        tempUnseen["给同目标、未见且未泄漏答案的平行问题；不在题旁给完整答案"]
        tempResult{"独立作答与必要解释是否达到本次目标？"}
        tempResultQualified{"作答未见、无提示帮助且范围一致？"}
        tempRetask["条件不合格只算过程观察；重新设计检查，不能授予掌握"]
        tempOutcome["报告本次表现、适用范围与尚未验证项；不声称长期掌握、已存档或已安排复习"]
        tempContinueChoice{"用户还要继续？"}
        tempExit["结束；Skill 不写用户画像、知识档案或排期"]
    end

    existingTemporary --> tempEntry
    noDataTemporary --> tempEntry
    tempEntry --> tempTask
    tempTask -->|"map-domain"| tempMap
    tempMap --> tempMapPick
    tempMapPick -->|"否"| tempMapEnd
    tempMapPick -->|"是"| tempGoal
    tempTask -->|"continue／recover"| tempContinue
    tempContinue --> tempGoal
    tempTask -->|"learn-one"| tempGoal
    tempGoal --> tempBoundary
    tempBoundary --> tempCoreOne
    tempCoreOne --> tempConceptRegistry
    tempConceptRegistry --> tempBasis
    tempBasis --> tempModelType
    tempModelType -->|"否"| tempCoreTwo
    tempModelType -->|"是"| tempModelUnderstood
    tempModelUnderstood -->|"否／未知"| tempModelGrounding
    tempModelGrounding --> tempCoreTwo
    tempModelUnderstood -->|"是"| tempFormulaNeeded
    tempFormulaNeeded -->|"否"| tempCoreTwo
    tempFormulaNeeded -->|"是"| tempFormulaDraft
    tempFormulaDraft --> tempCoreTwo
    tempCoreTwo --> tempDependency
    tempDependency -->|"否"| tempGround
    tempGround --> tempCoreOne
    tempDependency -->|"是"| tempUnit
    tempUnit --> tempMachineCheck
    tempMachineCheck --> tempMachinePass
    tempMachinePass -->|"否"| tempDraftReject
    tempMachinePass -->|"是"| tempAgentReview
    tempAgentReview --> tempSemanticPass
    tempSemanticPass -->|"否"| tempDraftReject
    tempDraftReject -->|"改写"| tempCoreTwo
    tempDraftReject -->|"真正前置缺口"| tempCoreOne
    tempSemanticPass -->|"是"| tempOutput
    tempOutput --> tempResponse
    tempResponse -. "语义作答证据只影响后续草稿；不是长期掌握" .-> tempModelUnderstood
    tempResponse --> tempReady
    tempReady -->|"否"| tempRepair
    tempRepair --> tempCoreOne
    tempReady -->|"是"| tempUnseen
    tempUnseen --> tempResultQualified
    tempResultQualified -->|"否"| tempRetask
    tempRetask --> tempUnseen
    tempResultQualified -->|"是"| tempResult
    tempResult -->|"否；反馈改变路径"| tempRepair
    tempResult -->|"是"| tempOutcome
    tempOutcome --> tempContinueChoice
    tempContinueChoice -->|"同会话、同模式、同范围"| tempGoal
    tempContinueChoice -->|"切换模式／扩大数据范围"| askDataMode
    tempContinueChoice -->|"否"| tempExit

    authorizedWrite --> MODE{"持久化任务类型？"}
    SNAPSHOT_RULE["只在已授权范围内，同次请求复用私有解析快照；每次新请求重新读盘；写后重新扫描，不跨请求缓存，不改变资格或锁规则"]
    authorizedWrite -. "读取执行约束" .-> SNAPSHOT_RULE
    TX_RULE["已授权生产 Vault writer 合同：同一 canonical Vault 的外部跨进程独占锁覆盖读取→CAS／资格重算→多文件写入→完整校验→失败回滚；争用超时／CAS 冲突零写入，回滚不得覆盖另一成功事务"]
    authorizedWrite -. "所有持久化 writer" .-> TX_RULE

    MODE -->|map-domain| MAP["生成完成当前判断所需的协调地图"]
    MAP --> MAPOUT["用户看到：结构、关键节点、证据边界和最少说明"]
    MAPOUT --> PICK{"用户选择节点继续学习？"}
    PICK -->|否| MAPEND["结束地图任务"]
    PICK -->|是| GOAL

    MODE -->|inspect| INSPECT["仅按明确授权展示可校正、可删除、带来源边界的内部快照"]
    INSPECT --> CORRECT{"用户是否纠正或删除数据？"}
    CORRECT -->|是| REBUILD_DERIVED["使相关派生值失效并重算；不改写原始事实"]
    CORRECT -->|否| INSPECT_END["结束 inspect"]
    REBUILD_DERIVED --> GOAL

    MODE -->|"continue / recover / rebuild"| LOCATE["只在已授权精确范围定位 Vault，并校验 manifest、证据与活动路线"]
    LOCATE --> ROUTE_FOUND{"存在唯一有效活动路线？"}
    ROUTE_FOUND -->|是| GOAL
    ROUTE_FOUND -->|多条| ASK_ROUTE["请用户选择路线；不得自动合并"]
    ASK_ROUTE --> LOCATE
    ROUTE_FOUND -->|无| ASK_CREATE["说明数据缺失；确认从未创建、重建或更换数据方式"]
    ASK_CREATE -->|未确认| STOP_RECOVERY["停止；不得静默初始化"]
    ASK_CREATE -->|"新建／重建／切换"| askDataMode

    MODE -->|learn-one| HISTORY_NEEDED{"需恢复已授权的既有路线？"}
    HISTORY_NEEDED -->|是| LOCATE
    HISTORY_NEEDED -->|否| GOAL

    subgraph CORE_A["核心一：知识边界、候选步骤与路线｜Agent 内部"]
        GOAL["定义可观察终点、情境、时间限制和 mastery contract"]
        DIAG["只发出当前 route issuance 快照中唯一匹配的 diagnostic probe； probe ID、activity、carrier 与 route binding 必须一致"]
        DIAG_REQUEST["把未解决缺口改写为 diagnose_now candidate_step； 先绑定 probe，再走完整候选选择和路线签发"]
        RAW["取得用户陈述或行为结果"]

        VALUE_GATE{"该 phase 的结果字段有真实消费者，且 evidence envelope 具备 phase/kind、完整 scope、canonical source、validity、route binding 与时间吗？"}
        DROP_VALUE["不计算或丢弃该字段；不触发任何状态更新"]
        BIND_VALUE["绑定 consumer_id 与完整追踪信息"]
        SOURCE_SPLIT["分开记录：自述／兴趣行为／诊断／教学过程／独立验证； 自述和模型生成内容不得授予 mastery"]
        TIME_GATE{"observed_at 不在未来，且 state.evaluated_at 不早于其最新支持证据吗？"}
        TIME_REJECT["拒绝提交和路由；校正时钟或证据时间，不让未来记录改变当前状态"]
        APPEND_DIAGNOSTIC["调用 append-evidence 原子提交诊断 evidence； 由 canonical session 反查来源，重算同 scope state、全部 boundary，旧 Focus 标 stale； 任一写入或派生校验失败则整次回滚"]

        BOUNDARY["按当前证据重算合同与边界；无证据保持 unknown； 图谱覆盖状态和学习者掌握状态分开，输出各自原因； 必要对比不等于先修，多层前置中的已验证掌握不被下层未知推翻"]
        GRAPH_COVERAGE{"目标前置图谱可用？ complete 或明确标明 legacy_unspecified 的兼容记录"}
        REPAIR_GRAPH["缺失／未评估／不完整：defer_unmodeled； 只补必要图谱，不把建模缺口转换成用户测试"]
        GRAPH["建立当前目标与 requires 先修闭包"]
        STEPS["生成可执行 candidate_step concept＋action＋probe/activity/verification 绑定"]

        HARD_GATE{"硬资格通过？ 同范围、目标闭包、mastery 相容、前置满足、硬约束满足"}
        REPLAN_BLOCK["回退最短阻塞前置；未建模时只补必要图谱"]
        ROUTE_LEVEL{"属于当前路线层级或恢复断点所需最短外缘？"}
        STANDBY["standby；跳离断点必须先重规划并递增 route_version"]
        ACTION_BIND{"动作绑定完整？ diagnose 有探针；teach 有活动和未见验证任务"}
        BIND_REPAIR["补齐可执行绑定；不能生成 teach_now / diagnose_now"]

        COST_GATE["在同 mastery gate、动作、层级和时间范围内比较成本向量"]
        PARETO{"成本状态？"}
        DOMINATED["dominated：排除；Focus 不得恢复"]
        COST_UNRESOLVED["unresolved：保留缺失值、fallback 估算及其来源；不得伪装成可比较成本"]
        UNRESOLVED_PRIORITY{"user_cost_priority 是否显式提供？"}
        UNRESOLVED_DEFAULT["priority=null：受限使用活动路线默认规则； selection_basis=route_default，不消费 Focus"]
        USER_COST["解析 issue-route.user_cost_priority：null 或 canonical 成本维度无重复数组； Pareto 前沿内只按每个候选真实成本向量逐维比较并记录代价"]
        USER_COST_VALID{"成本优先维度状态？"}
        RESIDUAL{"仍有多少个同动作、同层级、Pareto 前沿 active 候选？"}
        SELECT_DIRECT["选定唯一候选；selection_basis=route / cost / user_priority"]
        ISSUE_EVENT["调用 issue-route：锁内按 expected_chain_head 做 CAS，并从实时 Vault 重建候选； 非法／矛盾显式优先级，或显式优先级被 unresolved 阻塞时拒签；priority=null 的 unresolved 仅可 route_default 仅 canonical concept/resource 才发行；冻结 route/version＋purpose＋baseline＋priority/basis＋task＋context＋快照／指纹"]
        CHAIN_EVENT["追加顺序账本：sequence＋previous_hash＋event_hash； manifest 同步 anchor/head/length"]
        TRUST_MODE{"route_trust_level？"}
        TRUSTED_AUTH["trusted_seed_source：整链等于外部 seed； trusted_seed_prefix_local_extension：只证明 seed 前缀，后缀仍是本地链"]
        LOCAL_AUTH["local_chain_only：只检测非协同漂移； 不得宣称可抵抗同写权限协同重算"]
        ISSUANCE_GATE{"按声明的信任级别，链、manifest、context、task 与快照全部通过校验？"}
        ISSUANCE_REJECT["停止教学；定位损坏来源或追加新 route/version； 不得修改旧发行事件，也不得让 evidence 自证"]

        GOAL --> BOUNDARY
        RAW --> VALUE_GATE
        VALUE_GATE -->|否| DROP_VALUE
        DROP_VALUE --> DIAG_REQUEST
        DIAG_REQUEST --> STEPS
        VALUE_GATE -->|是| BIND_VALUE
        BIND_VALUE --> SOURCE_SPLIT
        SOURCE_SPLIT --> TIME_GATE
        TIME_GATE -->|否| TIME_REJECT
        TIME_REJECT --> DIAG_REQUEST
        TIME_GATE -->|是| APPEND_DIAGNOSTIC
        APPEND_DIAGNOSTIC --> BOUNDARY
        BOUNDARY --> GRAPH_COVERAGE
        GRAPH_COVERAGE -->|是| GRAPH
        GRAPH_COVERAGE -->|否| REPAIR_GRAPH
        REPAIR_GRAPH --> BOUNDARY
        GRAPH --> STEPS
        STEPS --> HARD_GATE
        HARD_GATE -->|否| REPLAN_BLOCK
        REPLAN_BLOCK --> GRAPH
        HARD_GATE -->|是| ROUTE_LEVEL
        ROUTE_LEVEL -->|否| STANDBY
        ROUTE_LEVEL -->|是| ACTION_BIND
        ACTION_BIND -->|否| BIND_REPAIR
        BIND_REPAIR --> STEPS
        ACTION_BIND -->|是| COST_GATE
        COST_GATE --> PARETO
        PARETO -->|dominated| DOMINATED
        PARETO -->|unresolved| COST_UNRESOLVED
        COST_UNRESOLVED --> UNRESOLVED_PRIORITY
        UNRESOLVED_PRIORITY -->|是| DIAG_REQUEST
        UNRESOLVED_PRIORITY -->|null| UNRESOLVED_DEFAULT
        UNRESOLVED_DEFAULT --> ISSUE_EVENT
        PARETO -->|frontier| USER_COST
        USER_COST --> USER_COST_VALID
        USER_COST_VALID -->|无明确优先或 valid| RESIDUAL
        USER_COST_VALID -->|inconsistent／invalid| COST_UNRESOLVED
        RESIDUAL -->|一个| SELECT_DIRECT
        SELECT_DIRECT --> ISSUE_EVENT
        ISSUE_EVENT --> CHAIN_EVENT
        CHAIN_EVENT --> TRUST_MODE
        TRUST_MODE -->|trusted| TRUSTED_AUTH
        TRUST_MODE -->|local| LOCAL_AUTH
        TRUSTED_AUTH --> ISSUANCE_GATE
        LOCAL_AUTH --> ISSUANCE_GATE
        ISSUANCE_GATE -->|否| ISSUANCE_REJECT
        ISSUANCE_REJECT --> LOCATE
    end

    DIAG --> U1["用户完成诊断问题或行为小任务"]
    U1 --> RAW

    subgraph FOCUS_BRIDGE["双核心桥梁：实验性 Focus Cone｜只排序剩余安全候选"]
        FOCUS_SCOPE{"所有候选是否同动作、同路线层级、同 gate、同 Pareto 前沿？"}
        FOCUS_INPUT{"全部候选的目标相关性、可靠兴趣证据、readiness 是否完整、有效、同范围，且快照 purpose=residual_candidate_order、消费者／used_in_decision 合法，并精确匹配当前 route_id＋route_version＋chain-head time_scope＋同一 decision batch，calculated_at 不在未来？"}
        INPUT_IMPACT{"缺失值可能改变选择且存在低成本探针？"}
        INFO_PROBE["执行高信息增益探针；focus_z=null"]
        ROUTE_DEFAULT["使用路线默认或稳定 ID；selection_basis 不写 focus"]
        FOCUS["计算 focus_z 0.40×目标相关性＋0.30×兴趣证据＋0.30×readiness 成本不进入公式"]
        UNIQUE_TOP{"存在唯一最高值？"}
        SELECT_FOCUS["选择最高候选；selection_basis=focus 记录基线选择与 priority hypothesis"]
        FOCUS_TIE["保留并列；使用 route_default / stable_tie_break"]

        RESIDUAL -->|至少两个| FOCUS_SCOPE
        FOCUS_SCOPE -->|否| ROUTE_DEFAULT
        FOCUS_SCOPE -->|是| FOCUS_INPUT
        FOCUS_INPUT -->|否| INPUT_IMPACT
        INPUT_IMPACT -->|是| INFO_PROBE
        INFO_PROBE --> DIAG_REQUEST
        INPUT_IMPACT -->|否| ROUTE_DEFAULT
        FOCUS_INPUT -->|是| FOCUS
        FOCUS --> UNIQUE_TOP
        UNIQUE_TOP -->|是| SELECT_FOCUS
        UNIQUE_TOP -->|否| FOCUS_TIE
    end

    SELECT_FOCUS --> ISSUE_EVENT
    FOCUS_TIE --> ISSUE_EVENT
    ROUTE_DEFAULT --> ISSUE_EVENT
    ISSUANCE_GATE -->|是| ISSUED_ACTION{"已签发 candidate_step 的 routing_action？"}
    ISSUED_ACTION -->|diagnose_now| DIAG
    ISSUED_ACTION -->|teach_now| CURRENT

    subgraph CORE_B["核心二：活动选择、教学、反馈与掌握验证"]
