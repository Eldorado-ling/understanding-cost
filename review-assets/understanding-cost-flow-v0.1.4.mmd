flowchart TD
    start(["v0.1.4 · 学习开始"]) --> consent["先明确三选一，无默认；同会话有效选择可复用"]
    consent -. "新会话、换模式或范围冲突须重新确认" .-> validity["确认前不查库、不诊断、不教学"]
    consent --> choice{"用户已明确选择"}
    choice -->|"尚未回答或含糊"| paused(["等待选择"])
    choice -->|"创建知识边界"| create[["确认独立位置与允许范围→最小诊断→结构化建档"]]
    choice -->|"使用自己的数据库"| existing["确认精确库与范围；默认只读，笔记不等于掌握"]
    existing --> writeGrant{"兼容 UC 库且另授追加写权？"}
    writeGrant -->|"是"| persistent
    writeGrant -->|"否；不新建、不复制、不改原库"| temporary
    choice -->|"不使用个人数据"| noData["不读历史、其他聊天或个人库；不建档、不算圆锥"]
    noData --> temporary
    create --> persistent

    persistent["持久化：仅已授权建档或兼容库另授写权"] --> coreOne[["核心一：边界与路径→硬资格与成本→合格候选才用圆锥"]]
    coreOne --> handoff["交接：本步概念/别名、已知锚点、待落地词"]
    handoff --> coreTwo[["核心二拟稿：新模型先问题/含义/例子，确认理解后才按需讲公式"]]
    coreTwo --> durableGate{"草稿语义复核与正文检查通过？"}
    durableGate -->|"通过"| durableCheck[["签发→核对实际投影→用户作答→反馈与未见检查→原子回写"]]
    durableGate -->|"拒绝"| durableRewrite["输出前改写或补前置"]
    durableRewrite --> coreTwo
    durableRewrite -. "真正前置缺口" .-> coreOne
    durableCheck --> contract{"合同结果"}
    contract -->|"不足；前置或路线需重算"| coreOne
    contract -->|"即时满足，保持未完成"| retention[["保持任务→不可变排期→到期验证；主动复习须新基线"]]
    retention --> durableCheck
    contract -->|"完整满足"| durableOutcome(["报告能力、范围与保持状态"])

    temporary["只读／无个人数据：仅使用本会话允许材料"] --> tempBoundary[["核心一：前提确认→临时边界与路径；无数据不算圆锥，只读不强算、不保存"]]
    tempBoundary --> tempHandoff["同一交接清单，仅在内存：概念/别名、已知与待落地词"]
    tempHandoff --> tempTeach[["核心二拟稿：新模型先问题/含义/例子，确认理解后才按需讲公式"]]
    tempTeach --> tempGate{"同一纯内存正文/定义检查与 Agent 语义复核通过？"}
    tempGate -->|"通过"| tempCheck[["输出本步→用户作答→最小反馈与未见检查；不写档案或排期"]]
    tempGate -->|"拒绝"| tempRewrite["输出前改写或补前置"]
    tempRewrite --> tempTeach
    tempRewrite -. "真正前置缺口" .-> tempBoundary
    tempCheck --> tempResult{"本次目标表现达到？"}
    tempResult -->|"未达到；反馈改变路径"| tempBoundary
    tempResult -->|"达到"| tempOutcome(["只报告本次表现；不声称长期掌握或已建档"])

